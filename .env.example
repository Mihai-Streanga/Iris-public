# Iris nu citește niciun fișier .env și nu are nevoie de chei: totul rulează local.
# Variabilele de mai jos sunt ale bibliotecii huggingface_hub, opționale, și se
# setează în mediu (nu în acest fișier) doar dacă vrei altă locație pentru modele.

# Unde stau modelele descărcate (implicit: ~/.cache/huggingface)
# HF_HOME=D:/modele/huggingface

# Interzice orice acces la rețea al bibliotecii (Iris oricum nu descarcă nimic)
# HF_HUB_OFFLINE=1
